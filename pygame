import streamlit as st
import random
import time

# 1. Cấu hình trang và tiêu đề giao diện
st.set_page_config(page_title="FNAF 1 - Streamlit Edition", page_icon="🐻", layout="centered")
st.title("🐻 Five Nights at Freddy's 1 - Web App")

# 2. Khởi tạo trạng thái Game (Session State) để giữ thông tin khi web tải lại
if "game_started" not in st.session_state:
    st.session_state.game_started = True
    st.session_state.power = 100.0
    st.session_state.time_am = 12
    st.session_state.start_time = time.time()
    st.session_state.last_tick = time.time()
    st.session_state.last_freddy_move = time.time()
    st.session_state.left_door = False
    st.session_state.right_door = False
    st.session_state.left_light = False
    st.session_state.camera_open = False
    st.session_state.current_cam = "CAM 1A (Sân khấu)"
    st.session_state.freddy_pos = "CAM 1A"  # Vị trí: CAM 1A -> CAM 1B -> CAM 2A -> OFFICE
    st.session_state.game_over = False
    st.session_state.win = False

# Hàm reset game khi chơi lại
def reset_game():
    st.session_state.power = 100.0
    st.session_state.time_am = 12
    st.session_state.start_time = time.time()
    st.session_state.last_tick = time.time()
    st.session_state.last_freddy_move = time.time()
    st.session_state.left_door = False
    st.session_state.right_door = False
    st.session_state.left_light = False
    st.session_state.camera_open = False
    st.session_state.current_cam = "CAM 1A (Sân khấu)"
    st.session_state.freddy_pos = "CAM 1A"
    st.session_state.game_over = False
    st.session_state.win = False

# 3. Cập nhật Logic Game theo thời gian thực (Mỗi lần trang web rerun)
current_now = time.time()

if not st.session_state.game_over and not st.session_state.win:
    # Tính thời gian trôi qua kể từ lần cập nhật trước
    elapsed_tick = current_now - st.session_state.last_tick
    st.session_state.last_tick = current_now
    
    # Tính toán lượng pin tiêu thụ dựa trên thiết bị đang mở
    drain_rate = 0.15  # Tiêu thụ cơ bản
    if st.session_state.left_door: drain_rate += 0.5
    if st.session_state.right_door: drain_rate += 0.5
    if st.session_state.left_light: drain_rate += 0.3
    if st.session_state.camera_open: drain_rate += 0.4
    
    st.session_state.power -= drain_rate * elapsed_tick
    if st.session_state.power <= 0:
        st.session_state.power = 0
        st.session_state.game_over = True

    # Cập nhật số giờ AM (Mỗi 30 giây thực tế lên 1 tiếng trong game)
    total_elapsed = current_now - st.session_state.start_time
    calculated_hour = 12 + int(total_elapsed / 30)
    if calculated_hour > 12:
        calculated_hour -= 12
    st.session_state.time_am = calculated_hour
    
    if total_elapsed >= 180:  # Sống sót 3 phút = Thắng
        st.session_state.win = True

    # AI của Freddy di chuyển (Mỗi 7 giây kiểm tra tỉ lệ di chuyển một lần)
    if current_now - st.session_state.last_freddy_move > 7:
        st.session_state.last_freddy_move = current_now
        if random.randint(1, 100) > 40:  # 60% tỉ lệ tiến lên
            if st.session_state.freddy_pos == "CAM 1A":
                st.session_state.freddy_pos = "CAM 1B"
            elif st.session_state.freddy_pos == "CAM 1B":
                st.session_state.freddy_pos = "CAM 2A"
            elif st.session_state.freddy_pos == "CAM 2A":
                if st.session_state.left_door:
                    st.session_state.freddy_pos = "CAM 1A"  # Bị chặn quay về sân khấu
                else:
                    st.session_state.freddy_pos = "OFFICE"  # Đột nhập thành công
                    st.session_state.game_over = True

# 4. GIAO DIỆN HIỂN THỊ TRÊN WEB (RENDER)
if st.session_state.game_over:
    st.error("💀 GAME OVER! FREDDY ĐÃ TẤN CÔNG BẠN TRONG BÓNG TỐI!")
    if st.button("Chơi Lại", on_click=reset_game):
        st.rerun()

elif st.session_state.win:
    st.success("🎉 6 AM! BẠN ĐÃ SỐNG SÓT QUA ĐÊM KINH HOÀNG!")
    if st.button("Chơi Lại", on_click=reset_game):
        st.rerun()

else:
    # HIỂN THỊ THÔNG SỐ SỐNG CÒN (HUD)
    col1, col2 = st.columns(2)
    with col1:
        st.metric(label="🔋 Năng lượng pin còn lại", value=f"{max(0, int(st.session_state.power))}%")
    with col2:
        st.metric(label="⏰ Thời gian hiện tại", value=f"{st.session_state.time_am} AM")

    # MỨC ĐỘ TIÊU THỤ ĐIỆN
    usage = 1 + int(st.session_state.left_door) + int(st.session_state.right_door) + int(st.session_state.left_light) + int(st.session_state.camera_open)
    st.text(f"Mức tiêu thụ điện: {'⚡' * usage}")

    st.divider()

    # CHẾ ĐỘ 1: ĐANG BẬT MÀN HÌNH CAMERA GÌÁM SÁT
    if st.session_state.camera_open:
        st.subheader(st.session_state.current_cam)
        
        # Logic hiển thị tình trạng các phòng qua Camera
        if "1A" in st.session_state.current_cam:
            if st.session_state.freddy_pos == "CAM 1A":
                st.warning("⚠️ Đèn flash quét qua: Phát hiện Gấu Freddy đang nhìn chằm chằm vào Camera!")
            else:
                st.info("Sân khấu trống không. Animatronic đã rời đi...")
        elif "1B" in st.session_state.current_cam:
            if st.session_state.freddy_pos == "CAM 1B":
                st.warning("⚠️ Tiếng động lớn ở khu ăn uống! Một bóng đen to lớn đang đứng giữa các bàn ăn.")
            else:
                st.info("Khu vực ăn uống tối đen, không phát hiện chuyển động.")
        elif "2A" in st.session_state.current_cam:
            if st.session_state.freddy_pos == "CAM 2A":
                st.error("🚨 NGUY HIỂM: Gấu Freddy đang chạy dọc hành lang trái về phía văn phòng của bạn!!!")
            else:
                st.info("Hành lang trái vắng lặng.")

        # Bản đồ nút chọn phòng Camera
        st.write("**Chọn Kênh Giám Sát:**")
        cam_col1, cam_col2, cam_col3 = st.columns(3)
        with cam_col1:
            if st.button("CAM 1A (Sân khấu)", use_container_width=True):
                st.session_state.current_cam = "CAM 1A (Sân khấu)"
        with cam_col2:
            if st.button("CAM 1B (Khu ăn uống)", use_container_width=True):
                st.session_state.current_cam = "CAM 1B (Khu ăn uống)"
        with cam_col3:
            if st.button("CAM 2A (Hành lang trái)", use_container_width=True):
                st.session_state.current_cam = "CAM 2A (Hành lang trái)"

    # CHẾ ĐỘ 2: ĐANG Ở VĂN PHÒNG BẢO VỆ
    else:
        st.subheader("🖥️ Góc nhìn văn phòng")
        
        # Cảnh báo đèn/tiếng động
        if st.session_state.left_light:
            if st.session_state.freddy_pos == "CAM 2A":
                st.error("😱 CÓ BÓNG NGƯỜI ĐỨNG BÊN NGOÀI CỬA SỔ TRÁI!!! ĐÓNG CỬA NGAY!!!")
            else:
                st.info("Đèn trái đang bật: Hành lang bên ngoài trống rỗng.")
        else:
            st.text("Hành lang hai bên tối om. Hãy bật đèn kiểm tra nếu nghe tiếng bước chân.")

        # Hiển thị trạng thái vật lý của Cửa
        st.write(f"Cửa Trái: {'🟥 ĐÃ ĐÓNG THẮT' if st.session_state.left_door else '🟩 ĐANG MỞ'}")
        st.write(f"Cửa Phải: {'🟥 ĐÃ ĐÓNG THẮT' if st.session_state.right_door else '🟩 ĐANG MỞ'}")

        # Các nút bấm tương tác tại văn phòng
        ctrl_col1, ctrl_col2 = st.columns(2)
        with ctrl_col1:
            st.button(
                "Đóng/Mở Cửa Trái 🚪", 
                key="btn_l_door", 
                on_click=lambda: setattr(st.session_state, 'left_door', not st.session_state.left_door),
                use_container_width=True
            )
            st.button(
                "Bật/Tắt Đèn Trái 💡", 
                key="btn_l_light", 
                on_click=lambda: setattr(st.session_state, 'left_light', not st.session_state.left_light),
                use_container_width=True
            )
        with ctrl_col2:
            st.button(
                "Đóng/Mở Cửa Phải 🚪", 
                key="btn_r_door", 
                on_click=lambda: setattr(st.session_state, 'right_door', not st.session_state.right_door),
                use_container_width=True
            )
            st.text("Hệ thống điện bên phải hoạt động bình thường.")

    st.divider()
    
    # NÚT CHUYỂN ĐỔI CHẾ ĐỘ CAMERA / VĂN PHÒNG LỚN Ở DƯỚI CÙNG
    st.button(
        "📂 BẬT / HẠ MÀN HÌNH CAMERA GIÁM SÁT", 
        key="toggle_cam", 
        on_click=lambda: setattr(st.session_state, 'camera_open', not st.session_state.camera_open),
        use_container_width=True,
        type="primary"
    )

    # 5. Kích hoạt tự động làm mới trang web (Tick rate) sau mỗi 0.8 giây để tạo chuyển động thời gian thực
    time.sleep(0.8)
    st.rerun()
